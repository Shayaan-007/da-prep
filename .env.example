# Required for AI features (mock interviews, feedback, STAR builder, statement review)
OPENAI_API_KEY=

# Optional model overrides.
# OPENAI_MODEL: marking and feedback (default gpt-6.1-sol)
# OPENAI_MODEL_FAST: interview questions and STAR drafts (default gpt-6-luna)
OPENAI_MODEL=
OPENAI_MODEL_FAST=

# Public URL of the deployed site (used for metadata, sitemap and robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only: serve canned AI responses so the UI works without an API key.
# Ignored when NODE_ENV=production.
MOCK_AI=

# Optional: accounts + cloud sync (run supabase/schema.sql first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: free-tier limits (needs Supabase above) and Stripe subscriptions
ENFORCE_LIMITS=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PRO_PRICE_LABEL=
